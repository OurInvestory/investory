# ===========================================
# Investory Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

# MySQL Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=investory
MYSQL_USER=investory
MYSQL_PASSWORD=investory123

# Redis
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-for-jwt-token-generation-minimum-32-characters-change-in-production
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# OAuth2 - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Mail Configuration (Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# ===========================================
# 배포용 추가 설정 (Phase 4)
# ===========================================
# 프론트엔드 도메인 (콤마 구분). 배포 시 반드시 실제 도메인으로 교체할 것.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 회원가입 시드머니 / 기존 유저 소급 지급 여부
SEED_MONEY=10000000
CASH_BACKFILL=true

# 주문 동시성 락 전략: optimistic | pessimistic
ORDER_LOCK_MODE=optimistic

# 시세 시뮬레이터
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_VOLATILITY=0.005
